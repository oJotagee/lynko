NODE_ENV="development"

PORT="8080"

DATABASE_URL="postgresql://admin:admin@localhost:5432/lynko"

JWT_SECRET="your-secret"
JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

CORS_ORIGIN="http://localhost:3000"

# Upload de mídia (opcional; sem AWS_REGION, S3_BUCKET e CDN_URL as rotas /media respondem 503)
# Região do bucket
AWS_REGION="us-east-1"
# Bucket privado das imagens
S3_BUCKET="lynko-media"
# Domínio do CloudFront, sem barra no final
CDN_URL="https://dxxxx.cloudfront.net"
# Credenciais do usuário IAM (fora da AWS); nunca versione os valores
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Tamanho máximo do avatar, em bytes
MEDIA_AVATAR_MAX_BYTES="5242880"
# Tamanho máximo da imagem de fundo, em bytes
MEDIA_BACKGROUND_MAX_BYTES="10485760"
# Uploads pendentes permitidos por página
MEDIA_MAX_PENDING_PER_PAGE="5"

# Redis de cache das páginas públicas (opcional; sem ele a leitura vai direto ao Postgres)
REDIS_URL="redis://localhost:6379"
# Redis da fila de analytics (opcional na API; obrigatório no worker)
QUEUE_REDIS_URL="redis://localhost:6380"

# TTL do cache da página pública, em segundos (4 horas)
PUBLIC_PAGE_CACHE_TTL="14400"
# TTL da chave username → revisão, em segundos (30 minutos)
PUBLIC_PAGE_REF_TTL="1800"
# Janela de refresh antes de expirar, em segundos
PUBLIC_PAGE_REFRESH_THRESHOLD="30"
# Expiração do lock de reconstrução, em milissegundos
PUBLIC_PAGE_LOCK_TTL_MS="10000"
# Espera máxima de quem aguarda a reconstrução, em milissegundos
PUBLIC_PAGE_WAIT_TIMEOUT_MS="5000"

# Token de GET /health/metrics (mínimo 32 caracteres; sem ele a rota responde 404)
# METRICS_TOKEN=""
