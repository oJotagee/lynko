# URL interna da API, usada pelas Server Actions e pelo NextAuth
API_URL="http://localhost:8080"

# Compatibilidade com a configuração anterior
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Gere com: bunx auth secret (não use o mesmo segredo da API)
AUTH_SECRET=""

# Em produção (next start) o Auth.js só aceita o host da requisição com uma destas opções.
# Use AUTH_URL com a URL pública; AUTH_TRUST_HOST=true só atrás de um proxy confiável ou localmente.
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST=true

# Google permanece desabilitado até a integração OAuth ser implementada na API
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL pública canônica do site (metadata, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
